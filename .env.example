# Copiar a .env (NO se commitea). En Azure van como App settings.
PORT=8080

# Secret en GitHub / App setting. Si queda vacío se usa un almacén en memoria (solo para desarrollo local).
STORAGE_CONNECTION_STRING=

# Variables (nombres de tablas)
TABLE_PERFIL=perfiles
TABLE_PRECIOS=precios

# Thumbprint SHA-1 del certificado cliente de APIM, sin los ":".
# Si queda vacío y NODE_ENV != production, el filtro de certificado se desactiva (solo local).
CLIENT_CERT_THUMBPRINT=
